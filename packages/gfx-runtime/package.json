{
  "name": "@hydra-tv/hydra-gfx-runtime",
  "version": "0.1.0",
  "description": "Shared template runtime for HYDRA // GFX (HtmlCanvas, layout primitives, template types).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gurleen/broadcast-graphics.git",
    "directory": "packages/gfx-runtime"
  },
  "homepage": "https://github.com/gurleen/broadcast-graphics/tree/main/packages/gfx-runtime",
  "bugs": {
    "url": "https://github.com/gurleen/broadcast-graphics/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./html": {
      "types": "./dist/html/index.d.ts",
      "import": "./dist/html/index.js"
    },
    "./html/HtmlCanvas": {
      "types": "./dist/html/HtmlCanvas.d.ts",
      "import": "./dist/html/HtmlCanvas.js"
    },
    "./html/LowerThird": {
      "types": "./dist/html/LowerThird.d.ts",
      "import": "./dist/html/LowerThird.js"
    },
    "./html/ui": {
      "types": "./dist/html/ui/index.d.ts",
      "import": "./dist/html/ui/index.js"
    },
    "./html/ui/*": {
      "types": "./dist/html/ui/*.d.ts",
      "import": "./dist/html/ui/*.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./colors": {
      "types": "./dist/colors.d.ts",
      "import": "./dist/colors.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "typescript": "^6.0.2",
    "zod": "^4.4.3"
  }
}
