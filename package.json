{
  "name": "broadcast-graphics",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --hot run dev-server.ts",
    "predev": "bun run build:ui",
    "generate-routes": "tsr generate",
    "test": "bun test",
    "build": "vite build",
    "prebuild": "bun run build:ui",
    "build:ui": "npm --prefix ui ci && npm --prefix ui run build",
    "start": "bun run serve.ts",
    "start:desktop": "bun run serve-desktop.ts",
    "preview": "vite preview",
    "build:sidecar": "bun run scripts/build-sidecar.ts",
    "prepare:desktop": "bun run scripts/prepare-desktop.ts",
    "build:example-pkg": "bun run --cwd examples/hgfx-package-example build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@gurleen-ui/broadcast": "file:ui/packages/broadcast",
    "@gurleen-ui/core": "file:ui/packages/core",
    "@gurleen-ui/tokens": "file:ui/packages/tokens",
    "@hydra/gfx-runtime": "file:packages/gfx-runtime",
    "@hydra/gfx-sdk": "file:packages/gfx-sdk",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tauri-apps/plugin-shell": "~2",
    "clsx": "^2.1.1",
    "hono": "^4.13.1",
    "motion": "^12.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.185.1",
    "yoga-layout": "^3.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "overrides": {
    "@gurleen-ui/core": "file:ui/packages/core",
    "@gurleen-ui/tokens": "file:ui/packages/tokens"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
